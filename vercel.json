{
  "version": 2,
  "builds": [
    { "src": "site/**/*", "use": "@vercel/static" },
    { "src": "data/**/*", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/data/(.*)", "dest": "data/$1" },
    { "src": "/assets/(.*)", "dest": "assets/$1" },
    { "src": "/lib/(.*)", "dest": "site/lib/$1" },
    { "src": "/css/(.*)", "dest": "site/css/$1" },
    { "src": "/js/(.*)", "dest": "site/js/$1" },
    { "src": "/exam-mode/(.*)", "dest": "site/exam-mode/$1" },
    { "src": "/exam.html", "dest": "site/exam.html" },
    { "src": "/(.*)", "dest": "site/index.html" }
  ]
}
